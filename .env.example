# Autonomous AI Job Application Agent Settings
APP_NAME="Autonomous AI Job Application Agent"
DATABASE_URL="sqlite:///data/app.db"
MASTER_CV_PATH="data/master_cv.json"
RESUMES_DIR="resumes"
BROWSER_USER_DATA_DIR="data/browser_profile"

# Automation Defaults
DEMO_MODE=true
DEFAULT_LOCATION="Chennai, Tamil Nadu, India"
MIN_MATCH_SCORE=70
MAX_APPS_PER_SESSION=10
MAX_APPS_PER_DAY=25
RATE_LIMIT_DELAY_SECONDS=3

# Configurable LLM Provider
LLM_PROVIDER="local_rule_based"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
